h1,
.h1 {
  font-family: var(--typoHeadingFontFamily);
  font-size: 7rem;
  line-height: 1.2;
  font-weight: 700;
}

h2,
.h2 {
  font-size: 5rem;
  line-height: 1.3;
  font-weight: 700;
}

h3,
.h3 {
  font-size: 3rem;
  line-height: 1.4;
}

/* paragraph */
p {
  font-size: 2rem;
  line-height: 1.5;
  margin: 0;
}

/* links */
a {
  font-size: 2rem;
  color: var(--colorPrimary);
  text-decoration: none;

  &:hover {
    text-decoration: underline;
     color: var(--colorPrimaryHover);
  }
}

/* lists */
ul,
ol {
  margin: 0;
  padding: 0;
}

li {
  font-size: 2rem;
  line-height: 1.5;
}