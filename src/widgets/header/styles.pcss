.header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 2rem 3rem;
  background: var(--colorWhite);
  border-bottom: 1px solid var(--colorGray200);
}

.header {
  &__logo{
    font-size: 2rem;
    font-weight: 700;
    color: var(--colorBlack);
    text-decoration: none;
  }
 
}

.header {
  &__right{
    display: flex;
    gap: 1.5rem;
  }
  
}