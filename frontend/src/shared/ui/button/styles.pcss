.button {
  --btnHeight: 4.8rem;
  --btnPaddingX: 2rem;
  --btnRadius: 1rem;

  --btnFontSize: 1.6rem;
  --btnFontWeight: 600;

  --btnBg: var(--colorPrimary);
  --btnBgHover: var(--colorPrimaryHover);
  --btnBgActive: #b91c12;

  --btnText: var(--colorWhite);
  --btnTextHover: var(--colorWhite);
  --btnBorder: transparent;

  --btnDisabledBg: var(--colorGray200);
  --btnDisabledText: var(--colorGray500);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: var(--btnHeight);
  padding: 0 var(--btnPaddingX);
  font-size: var(--btnFontSize);
  font-weight: var(--btnFontWeight);
  color: var(--btnText);
  background: var(--btnBg);
  border: 1px solid var(--btnBorder);
  border-radius: var(--btnRadius);
  cursor: pointer;
  transition: 0.2s ease;

  &:hover {
    background: var(--btnBgHover);
    color: var(--btnTextHover);
  }

  &:active {
    background: var(--btnBgActive);
  }

  &:focus-visible {
    outline: 2px solid var(--colorPrimarySoft);
    outline-offset: 2px;
  }

  &:disabled {
    background: var(--btnDisabledBg);
    color: var(--btnDisabledText);
    cursor: not-allowed;
    pointer-events: none;
  }

  &--isSecondary {
    --btnBg: transparent;
    --btnText: var(--colorPrimary);
    --btnBorder: var(--colorPrimary);
    --btnBgHover: var(--colorPrimarySoft);
  }

  &--isTransparent {
    --btnBg: transparent;
    --btnText: var(--colorPrimary);
    --btnPaddingX: 0;
  }

  &--link {
    &:hover {
      text-decoration: none;
    }
  }
}
