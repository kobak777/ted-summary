.button {
  /* vars */
  --height: 4.8rem;
  --paddingX: 2rem;
  --radius: 1rem;

  --fontSize: 1.6rem;
  --fontWeight: 600;

  --bg: var(--colorPrimary);
  --bgHover: var(--colorPrimaryHover);
  --bgActive: #b91c12;

  --text: var(--colorWhite);
  --border: transparent;

  --disabledBg: var(--colorGray200);
  --disabledText: var(--colorGray500);

  /* base */

  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: var(--height);
  padding: 0 var(--paddingX);
  font-size: var(--fontSize);
  font-weight: var(--fontWeight);
  color: var(--text);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  transition: 0.2s ease;
}

/* hover */
.button:hover {
  background: var(--bgHover);
}

/* active */
.button:active {
  background: var(--bgActive);
  transform: scale(0.98);
}

/* focus */
.button:focus-visible {
  outline: 2px solid var(--colorPrimarySoft);
  outline-offset: 2px;
}

/* disabled */
.button:disabled {
  background: var(--disabledBg);
  color: var(--disabledText);
  cursor: not-allowed;
  pointer-events: none;
}

/* secondary */
.button--secondary {
  --bg: transparent;
  --text: var(--colorPrimary);
  --border: var(--colorPrimary);
  --bgHover: var(--colorPrimarySoft);
}
