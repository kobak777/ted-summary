.loader {
  &__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  &__spinner {
    border-style: solid;
    border-color: var(--colorGray200);
    border-top-color: var(--colorPrimary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    width: 25rem;
    height: 25rem;
    border-width: 3px;
  }

  &__text {
    color: var(--colorGray500);
    font-size: 3rem;
    margin: 0;
  }
}

