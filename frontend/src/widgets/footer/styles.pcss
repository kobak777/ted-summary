.footer {
  margin-top: auto;
  background: var(--gradientFooter);
  padding: 2.5rem 4rem;
  display: flex;
  justify-content: space-between;
  align-items: center;

  @media (max-width: 768px) {
    flex-direction: column;
    gap: 2rem;
    padding: 2rem 2.5rem;
  }

  &__logo {
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--colorWhite);
    text-decoration: none;

    &:hover {
      opacity: 0.8;
    }
  }

  &__policy {
    font-size: 1.75rem; /* 14px */
    color: var(--colorGray500);
    text-decoration: none;

    &:hover {
      color: var(--colorWhite);
      text-decoration: underline;
    }
  }
}
