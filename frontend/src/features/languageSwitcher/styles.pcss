.languageSwitcher {
  position: relative;

  &__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    font-size: 1.6rem;
    cursor: pointer;
  }

  &__dropdown {
    position: absolute;
    top: calc(100% + 0.8rem);
    right: 0;
    min-width: 8rem;
    padding: 0.4rem;
    background: var(--colorWhite);
    border: 1px solid var(--colorGray200);
    border-radius: 0.8rem;
    box-shadow: 0 10px 30px rgb(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    animation: fadeIn 0.12s ease;
    overflow: hidden;
  }

  &__option {
    padding: 0.6rem 1rem;
    font-size: 1.4rem;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: 0.15s ease;
    border-radius: 0.6rem;

    &:hover {
      background: var(--colorPrimarySoft);
      color: var(--colorPrimary);
    }

    &:active {
      transform: scale(0.98);
    }
  }
}
