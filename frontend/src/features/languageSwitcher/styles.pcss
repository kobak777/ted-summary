.languageSwitcher {
  position: relative;

  &__dropdown {
    position: absolute;
    top: calc(100% + 0.8rem);
    right: 0;
    min-width: 8rem;
    background: var(--colorWhite);
    border: 1px solid var(--colorGray200);
    border-radius: 1.2rem;
    box-shadow: 0 10px 25px -5px rgb(0, 0, 0, 0.1), 0 8px 10px -6px rgb(0, 0, 0, 0.02);
    z-index: 100;
    opacity: 0;
    transform: translateY(-8px);
    animation: dropdownSlideIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;

    &:hover {
      &::before {
        background: var(--colorPrimarySoft);
      }
    }

    &::before {
      content: '';
      position: absolute;
      top: -5px;
      right: 1.5rem;
      width: 10px;
      height: 10px;
      background: var(--colorWhite);
      border-left: 1px solid var(--colorGray200);
      border-top: 1px solid var(--colorGray200);
      transform: rotate(45deg);
      pointer-events: none;
    }
  }

  .button.languageSwitcher__option {
    width: 100%;
    padding: 1rem 1.2rem;
    font-size: 1.4rem;
    font-weight: 500;
    text-align: left;
    border: none;
    border-radius: 0.8rem;
    background: var(--colorWhite);
    cursor: pointer;
    color: var(--colorBlack);
    transition: all 0.15s ease;

    &:hover {
      background: var(--colorPrimarySoft);
      color: var(--colorPrimary);
    }

    &:active {
      transform: scale(0.96);
    }
  }
}

@keyframes dropdownSlideIn {
  0% {
    opacity: 0;
    transform: translateY(-8px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
